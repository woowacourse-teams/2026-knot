{
  "name": "knot-frontend",
  // /relay 아래 요청만 받는 중계 Worker예요(ADR 838). 나머지 주소는 아래 run_worker_first에 걸리지 않아 정적 파일로 바로 나가요
  // 피드백을 Notion 접수함에 넣는 토큰(ADR 930)은 저장소에 두지 않고 `wrangler secret put NOTION_FEEDBACK_TOKEN --env dev|prod`로 넣어요
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // 이 경로만 Worker를 먼저 거쳐요. 바꾸면 src/worker의 RELAY_PATH도 함께 바꿔요
    "run_worker_first": ["/relay/*"],
  },
  "env": {
    "dev": {
      "name": "knot-frontend-dev",
    },
    "prod": {
      "name": "knot-frontend",
    },
  },
}
