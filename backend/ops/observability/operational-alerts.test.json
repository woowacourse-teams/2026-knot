    {
      "name": "missing operational heartbeat",
      "interval": "1m",
      "input_series": [],
      "promql_expr_test": [
        {
          "expr": "(max(time() - knot_operational_check_timestamp_seconds{env=\"prod\"}) > bool 180) or absent(knot_operational_check_timestamp_seconds{env=\"prod\"})",
