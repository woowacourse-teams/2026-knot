      "promql_expr_test": [
        {
          "expr": "(max(time() - knot_rds_backup_latest_restorable_timestamp_seconds{env=\"prod\"}) > bool 3600) + (1 - min(knot_rds_backup_check_success{env=\"prod\"})) + (min(knot_rds_backup_retention_days{env=\"prod\"}) < bool 1) + (max(time() - knot_rds_backup_check_timestamp_seconds{env=\"prod\"}) > bool 900)",
          "eval_time": "30m",
          "exp_samples": [
            {
              "labels": "{}",
              "value": 0
            }
          ]
        }
      ]
    },
