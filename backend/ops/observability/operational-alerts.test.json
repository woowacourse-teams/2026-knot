      "promql_expr_test": [
        {
          "expr": "max(knot_systemd_service_failed{env=\"prod\"}) + (1 - min(knot_required_service_active{env=\"prod\"})) + (1 - min(knot_backend_service_active{env=\"prod\"})) + (1 - min(knot_service_check_success{env=\"prod\"}))",
