{
  "rule_files": [],
  "evaluation_interval": "1m",
  "tests": [
    {
      "name": "healthy services with inactive standby",
      "interval": "1m",
      "input_series": [
        {
          "series": "knot_systemd_service_failed{env=\"prod\",unit=\"knot-backend-green.service\"}",
          "values": "0x120"
        },
        {
          "series": "knot_required_service_active{env=\"prod\",unit=\"nginx.service\"}",
          "values": "1x120"
        },
        {
          "series": "knot_backend_service_active{env=\"prod\"}",
          "values": "1x120"
        },
        {
          "series": "knot_service_check_success{env=\"prod\"}",
          "values": "1x120"
        }
      ],
      "promql_expr_test": [
        {
          "expr": "max(knot_systemd_service_failed{env=\"prod\"}) + (1 - min(knot_required_service_active{env=\"prod\"})) + (1 - min(knot_backend_service_active{env=\"prod\"})) + (1 - min(knot_service_check_success{env=\"prod\"}))",
          "eval_time": "30m",
          "exp_samples": [
            {
              "labels": "{}",
              "value": 0
            }
          ]
        }
      ]
    },
    {
      "name": "failed standby must be visible",
      "interval": "1m",
      "input_series": [
        {
          "series": "knot_systemd_service_failed{env=\"prod\",unit=\"knot-backend-green.service\"}",
          "values": "1x120"
        },
        {
          "series": "knot_required_service_active{env=\"prod\",unit=\"nginx.service\"}",
          "values": "1x120"
        },
        {
          "series": "knot_backend_service_active{env=\"prod\"}",
          "values": "1x120"
        },
        {
          "series": "knot_service_check_success{env=\"prod\"}",
          "values": "1x120"
        }
