        },
        {
          "refId": "B",
          "expr": "knot_ai_jobs_completed_total{project=\"knot\",env=\"shared\",job=\"mac-ai\",instance=\"knot-ai-macmini\",ai_scope=\"$ai_scope\",outcome=\"failed\"} and on(project,env,job,instance,ai_scope) ((up{project=\"knot\",env=\"shared\",job=\"mac-ai\",instance=\"knot-ai-macmini\",ai_scope=\"$ai_scope\"} and (time() - timestamp(up{project=\"knot\",env=\"shared\",job=\"mac-ai\",instance=\"knot-ai-macmini\",ai_scope=\"$ai_scope\"}) < 20)) == 1)",
