      "targets": [
        {
          "refId": "A",
          "expr": "knot_ai_active_jobs{project=\"knot\",env=\"shared\",job=\"mac-ai\",instance=\"knot-ai-macmini\",ai_scope=\"$ai_scope\"} and on(project,env,job,instance,ai_scope) ((up{project=\"knot\",env=\"shared\",job=\"mac-ai\",instance=\"knot-ai-macmini\",ai_scope=\"$ai_scope\"} and (time() - timestamp(up{project=\"knot\",env=\"shared\",job=\"mac-ai\",instance=\"knot-ai-macmini\",ai_scope=\"$ai_scope\"}) < 20)) == 1)",
          "legendFormat": "진행 작업 수",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "데이터 없음"
        },
        "overrides": []
