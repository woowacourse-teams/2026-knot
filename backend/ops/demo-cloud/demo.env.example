# Copy outside the repository; chmod 600. Fill credentials using your secret manager.
TRANSCRIPTION_ENABLED=true
TRANSCRIPTION_PROVIDER=clova
CLOVA_SPEECH_INVOKE_URL=
CLOVA_SPEECH_API_KEY=
# Whole-file mode. Drain every existing incremental/input-preparation job before switching.
RECORDING_INCREMENTAL_TRANSCRIPTION_ENABLED=false
RECORDING_AUDIO_FINALIZATION_ENABLED=true
TRANSCRIPTION_REQUEST_TIMEOUT=PT30S
TRANSCRIPTION_JOB_TIMEOUT=PT2M
TRANSCRIPTION_DISPATCH_INTERVAL=PT1S
LLM_ENABLED=true
LLM_PROVIDER=claude
LLM_BASE_URL=https://api.anthropic.com
LLM_API_TOKEN=
LLM_MODEL=claude-sonnet-5-5
CLAUDE_THINKING_TYPE=between_tools
LLM_REQUEST_TIMEOUT=PT60S
MEETING_SUMMARY_WORKER_ENABLED=true
DOCUMENT_GENERATION_WORKER_ENABLED=true
MEETING_SUMMARY_WORKER_POLL_INTERVAL=PT1S
DOCUMENT_GENERATION_WORKER_POLL_INTERVAL=PT1S
